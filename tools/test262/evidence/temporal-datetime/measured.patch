+            continue;
+        }
+        let x = i.get_prop_value_str(v, key)?;
+        if matches!(x, Value::Undefined) {
+            continue;
+        }
+        if let Some(n) = TIME_FIELDS.iter().position(|s| *s == key) {
+            time[n] = Some(integer(i, &x, false)?);
+        } else {
