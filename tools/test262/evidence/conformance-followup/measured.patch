+fn now_instant(i: &mut Interpreter, _: Value, _: Vec<Value>) -> Result<Value, VmErr> {
+    wrap(i, Slots::Instant(current_instant()?), false)
+}
+fn now_timezone_id(_: &mut Interpreter, _: Value, _: Vec<Value>) -> Result<Value, VmErr> {
