+fn zoned_transition(i: &mut Interpreter, t: Value, a: Vec<Value>) -> Result<Value, VmErr> {
+    let d = zoned(&t)?;
+    let v = arg(&a, 0);
+    if matches!(v, Value::Undefined) {
+        return vm_err("TypeError: transition options required");
+    }
+    let s = if let Value::String(ref s) = v {
+        s.to_string()
+    } else {
