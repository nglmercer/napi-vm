+        )
+        .map_err(err);
+    }
+    let Value::String(s) = v else {
+        return vm_err("TypeError: year-month must be a string or object");
+    };
+    let d = PlainYearMonth::from_utf8(s.to_string().as_bytes()).map_err(err)?;
+    overflow(i, opts)?;
+    Ok(d)
