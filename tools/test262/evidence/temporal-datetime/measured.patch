+}
+fn instant_compare(i: &mut Interpreter, _: Value, a: Vec<Value>) -> Result<Value, VmErr> {
+    let t = to_instant(i, &arg(&a, 0))?;
+    let other = to_instant(i, &arg(&a, 1))?;
+    Ok(Value::Number(t.cmp(&other) as i8 as f64))
+}
