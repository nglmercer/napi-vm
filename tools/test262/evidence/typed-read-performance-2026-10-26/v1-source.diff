+    /// Read a single typed-array element without allocating a temporary Vec.
+    pub(crate) fn read_element_bytes(&self, offset: usize, length: usize) -> Option<[u8; 8]> {
+        if length > 8 {
+            return None;
+        }
+        let mut output = [0; 8];
+        match self {
+            Self::Array(buffer) => {
+                let bytes = buffer.borrow();
+                let end = offset.checked_add(length)?;
+                output[..length].copy_from_slice(bytes.get(offset..end)?);
+            }
+            Self::Shared(buffer) => output[..length].copy_from_slice(&buffer.read(offset, length)?),
+        }
+        Some(output)
+    }
