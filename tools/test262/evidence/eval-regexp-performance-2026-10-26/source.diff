+#[test]
+fn eval_regexp_literals_create_independent_objects_and_validate_syntax() {
+    let source = r#"
+        let first = eval('/a/g');
+        let second = eval('/a/g');
+        first.lastIndex = 7;
+        let invalid = false;
+        try { eval('/[/'); } catch (e) { invalid = e instanceof SyntaxError; }
+        first !== second && second.lastIndex === 0 && second.source === 'a' && invalid;
+        "#;
+    check(source, true);
+    assert!(matches!(
+        run_ast_with_modules(source, &[]),
+        Ok(Value::Bool(true))
+    ));
+}
