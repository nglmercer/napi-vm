+fn regexp_escape(_: &mut Interpreter, _: Value, args: Vec<Value>) -> Result<Value, VmErr> {
+    let Some(Value::String(text)) = args.first() else {
+        return Err(VmErr::Msg(
+            "TypeError: RegExp.escape requires a string".into(),
+        ));
+    };
