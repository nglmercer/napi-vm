diff --git a/tests/typed_array_numeric_access.rs b/tests/typed_array_numeric_access.rs
new file mode 100644
index 0000000..d1b4090
--- /dev/null
+++ b/tests/typed_array_numeric_access.rs
@@ -0,0 +1,49 @@
+use napi_vm::{Interpreter, Value};
+
+#[test]
+fn numeric_indices_preserve_zero_invalid_indices_and_value_coercion() {
+    let mut vm = Interpreter::with_builtins();
+    vm.eval_source(
+        r#"
+        var a = new Uint8Array([3, 4]), calls = 0;
+        var proto = Object.create(Object.getPrototypeOf(a));
+        proto['-1'] = 99;
+        Object.setPrototypeOf(a, proto);
+        a[-0] = 7;
+        a['-0'] = 55;
+        var converted = {valueOf(){calls++;return 9}};
+        for (var key of [-1, 0.5, NaN, Infinity, 2]) a[key] = converted;
+        var result = [a[-0], a['-0'], a[-1], a[0.5], a[NaN], a[Infinity], a[2], calls,
+            Reflect.get(a, '0', {}), Object.keys(a)];
+    "#,
+    )
+    .unwrap();
+    let result = vm.eval_source("JSON.stringify(result)").unwrap();
+    assert!(
+        matches!(&result, Value::String(s) if s == r#"[7,null,null,null,null,null,null,5,7,["0","1"]]"#),
+        "{result:?}"
+    );
+}
+
+#[test]
+fn numeric_access_observes_detachment_and_bigint_coercion() {
+    let mut vm = Interpreter::with_builtins();
+    let result = vm
+        .eval_source(
+            r#"
+        var a = new BigInt64Array([1n]);
+        a[-0] = {valueOf(){return 9n}};
+        var before = a[0], calls = 0;
+        a.buffer.transfer();
+        a[0] = {valueOf(){calls++;return 2n}};
+        var threw = false;
+        try { a[Infinity] = 1; } catch(e) { threw = e instanceof TypeError; }
+        JSON.stringify([String(before), a[0], calls, threw]);
+    "#,
+        )
+        .unwrap();
+    assert!(
+        matches!(&result, Value::String(s) if s == r#"["9",null,1,true]"#),
+        "{result:?}"
+    );
+}
