+    let source = r#"
+        let s = '\uD800', log = '';
+        let object = {};
+        object[Symbol.toPrimitive] = function(hint) { log += hint; return 'x'; };
+        let result = s + '\uDC00';
+        result.length === 2 && result.codePointAt(0) === 0x10000 &&
+          ('a' + object) === 'ax' && log === 'default';
+    "#;
+    check(source, true);
+    assert!(matches!(
+        run_ast_with_modules(source, &[]),
+        Ok(Value::Bool(true))
+    ));
+}
