+                ("writable".into(), Value::Bool(true)),
+                ("enumerable".into(), Value::Bool(true)),
+                ("configurable".into(), Value::Bool(true)),
+            ]),
+        )?
+    } else {
+        i.set_member_with_receiver(&this, &key, value, &this)?
+    };
+    if !accepted {
+        return Err(VmErr::Msg("TypeError: Cannot set Error stack".into()));
+    }
+    Ok(Value::Undefined)
+}
