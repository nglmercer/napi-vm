+fn legacy_year(year: i64) -> i64 {
+    match year {
+        0..=49 => year + 2000,
+        50..=99 => year + 1900,
+        _ => year,
+    }
+}
+
+fn legacy_civil(year: i64, month: i64, day: i64) -> Option<f64> {
+    if !(1..=12).contains(&month) || !(1..=31).contains(&day) {
+        return None;
+    }
+    Some(utc_ms(legacy_year(year), month, day, 0, 0, 0, 0))
+}
+
+fn parse_legacy_civil(text: &str) -> Option<f64> {
+    if text.contains('/') {
+        let parts: Vec<_> = text.split('/').collect();
+        if parts.len() != 3
+            || parts
+                .iter()
+                .any(|part| part.is_empty() || !part.bytes().all(|b| b.is_ascii_digit()))
+        {
+            return None;
+        }
+        let a: i64 = parts[0].parse().ok()?;
+        let b: i64 = parts[1].parse().ok()?;
+        let c: i64 = parts[2].parse().ok()?;
+        return if a > 31 {
+            legacy_civil(a, b, c)
+        } else {
+            legacy_civil(c, a, b)
+        };
+    }
+    let words: Vec<_> = text.split_whitespace().collect();
+    if words.len() != 3 {
+        return None;
+    }
+    let month_index = words.iter().position(|word| {
+        word.get(..3).is_some_and(|prefix| {
+            MONTHS
+                .iter()
+                .any(|month| prefix.eq_ignore_ascii_case(month))
+        })
+    })?;
+    let word = words[month_index];
+    let prefix = word.get(..3)?;
+    let month = MONTHS
+        .iter()
+        .position(|name| prefix.eq_ignore_ascii_case(name))? as i64
+        + 1;
+    let nums: Vec<i64> = words
+        .iter()
+        .enumerate()
+        .filter(|(index, _)| *index != month_index)
+        .map(|(_, word)| word.trim_end_matches(',').parse())
+        .collect::<Result<_, _>>()
+        .ok()?;
+    let (year, day) = if nums[0] > 31 {
+        (nums[0], nums[1])
+    } else {
+        (nums[1], nums[0])
+    };
+    legacy_civil(year, month, day)
+}
