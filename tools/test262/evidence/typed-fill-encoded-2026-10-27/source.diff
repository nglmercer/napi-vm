+#[test]
+fn typed_fill_reuses_encoded_values_without_skipping_coercion() {
+    let source = r#"
+        let calls = 0;
+        let a = new Int16Array(new ArrayBuffer(80), 4, 32);
+        a.fill({valueOf() { calls++; return -32769; }}, 3, 29);
+        let b = new Float64Array(32); b.fill(-0, 2, 30);
+        let c = new BigInt64Array(32); c.fill(-3n, 1, 31);
+        let shared = new Int16Array(new SharedArrayBuffer(64)); shared.fill(42, 2, 30);
+        calls === 1 && a[2] === 0 && a[3] === 32767 && a[28] === 32767 && a[29] === 0 &&
+          Object.is(b[2], -0) && Object.is(b[29], -0) && Object.is(b[30], 0) &&
+          c[1] === -3n && c[30] === -3n && c[31] === 0n && shared[2] === 42 && shared[30] === 0;
+        "#;
+    check(source, true);
+    assert!(matches!(
+        run_ast_with_modules(source, &[]),
+        Ok(Value::Bool(true))
+    ));
+}
