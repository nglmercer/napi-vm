{
  "name": "napi-vm",
  "version": "0.1.5",
  "description": "A sandboxed JavaScript virtual machine built from scratch in Rust with NAPI bindings for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "*.node",
    "docs",
    "lsp",
    "runtime",
    "plugins"
  ],
  "scripts": {
    "build": "npx napi build --platform --release --js index.js",
    "build:all": "bun run build:esm && bun run build:commonjs",
    "build:esm": "npx napi build --platform --release --esm --js index.mjs",
    "build:commonjs": "npx napi build --platform --release --commonjs --js index.js",
    "build:debug": "npx napi build --platform --js index.js",
    "lint": "bun run lint:rust && bun run lint:ts",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings",
    "lint:ts": "tsc --noEmit",
    "lint:playground": "tsc --noEmit -p playground/tsconfig.json",
    "check:generated": "bun run build:all && git diff --exit-code -- index.js index.mjs index.d.ts",
    "test": "bun test",
    "test:node": "node --test tests/node/*.test.js",
    "test:rust": "cargo test --release",
    "test:wasm": "npm run playground:build && npm run lint:playground && node --test tests/wasm/*.test.mjs",
    "bench": "node bench/bench.js",
    "bench:stress": "bun bench/stress.ts",
    "bench:rust": "cargo bench",
    "lsp": "cargo run --release --no-default-features --bin napi-vm-lsp",
    "lsp:build": "cargo build --release --no-default-features --bin napi-vm-lsp",
    "lsp:test": "cargo test --release --no-default-features --test lsp_protocol --test lsp_runtime",
    "lsp:legacy": "node lsp/server.cjs",
    "lsp:legacy-smoke": "node lsp/smoke.cjs",
    "lsp:legacy-runtime-smoke": "node lsp/runtime-smoke.cjs",
    "ipc:smoke": "bun examples/ipc-smoke.ts",
    "runtime:smoke": "node runtime/smoke.cjs",
    "zed:build": "cargo build --manifest-path zed-extension/Cargo.toml --target wasm32-wasip2 --release",
    "playground:build": "wasm-pack build --target web --out-dir playground/pkg --release -- --no-default-features --features wasm",
    "playground": "vite --config playground/vite.config.ts",
    "plugins:example": "bun examples/plugins.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nglmercer/napi-vm.git"
  },
  "homepage": "https://github.com/nglmercer/napi-vm#readme",
  "bugs": {
    "url": "https://github.com/nglmercer/napi-vm/issues"
  },
  "keywords": [
    "vm",
    "sandbox",
    "javascript",
    "interpreter",
    "rust",
    "napi",
    "native",
    "ecmascript",
    "execution",
    "isolated"
  ],
  "author": "nglmercer",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "napi": {
    "binaryName": "napi-vm",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.9.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "miniaudio_node": "1.6.3",
    "preact": "^10.29.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  }
}
