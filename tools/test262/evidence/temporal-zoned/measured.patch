+                .map_err(|_| VmErr::Msg("RangeError: invalid disambiguation".into()))
+        })
+        .transpose()
+}
+fn zoned_options(
+    i: &mut Interpreter,
+    v: Value,
+) -> Result<
+    (
+        Option<Disambiguation>,
+        Option<OffsetDisambiguation>,
+        Overflow,
+    ),
+    VmErr,
+> {
+    let v = options(v)?;
+    let d = disambiguation(i, &v)?;
+    let o = offset_option(i, &v)?;
+    let f = overflow(i, v)?;
