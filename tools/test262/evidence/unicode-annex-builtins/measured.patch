+++ b/crates/napi-vm-core/src/builtins/intl/plurals.rs
@@ -0,0 +1,407 @@
+//! Plural categories from CLDR, selected after observable decimal rounding.
+use super::*;
+use fixed_decimal::{
+    Decimal, RoundingIncrement, SignedRoundingMode as RM, UnsignedRoundingMode as UM,
+};
+use icu_plurals::{PluralOperands, PluralRuleType, PluralRules, PluralRulesWithRanges};
+#[derive(Clone)]
+pub(crate) struct Slots {
+    rules: Rc<PluralRules>,
+    ranges: Rc<PluralRulesWithRanges<PluralRules>>,
+    locale: String,
+    kind: String,
+    notation: String,
+    compact: String,
+    integer: i16,
+    min_fraction: i16,
+    max_fraction: i16,
+    min_significant: Option<i16>,
+    max_significant: Option<i16>,
+    increment: i16,
+    mode: String,
+    priority: String,
+    trailing: String,
+}
+fn error() -> VmErr {
+    VmErr::Msg("TypeError: Intl.PluralRules receiver required".into())
+}
+fn slot(v: &Value) -> Result<Slots, VmErr> {
+    v.property_cell()
+        .and_then(|p| p.meta.borrow().intl_plurals.clone())
+        .ok_or_else(error)
+}
+fn choice(
+    i: &mut Interpreter,
+    o: &Value,
+    key: &str,
+    default: &str,
+    allowed: &[&str],
+) -> Result<String, VmErr> {
+    let v = option(i, o, key)?.unwrap_or_else(|| default.into());
+    if !allowed.contains(&v.as_str()) {
+        return Err(range());
+    }
+    Ok(v)
+}
+fn number(i: &mut Interpreter, v: &Value, min: i16, max: i16, default: i16) -> Result<i16, VmErr> {
+    if matches!(v, Value::Undefined) {
+        return Ok(default);
+    }
+    let n = i.ecmascript_to_number(v)?;
+    if n.is_nan() || n < (min as f64) || n > (max as f64) {
+        return Err(range());
+    }
+    Ok(n.floor() as i16)
+}
+fn construct(i: &mut Interpreter, _: Value, args: Vec<Value>) -> Result<Value, VmErr> {
+    let target = i.new_target_stack.last().cloned().ok_or_else(error)?;
+    let prototype = i.constructor_prototype(&target, "Intl.PluralRules")?;
+    let requested = locale_list(i, arg(&args, 0))?;
+    let options = match arg(&args, 1) {
+        Value::Undefined => Value::object_with_proto(vec![], None),
+        Value::Null => return Err(error()),
+        v => Value::boxed_primitive(v.clone()).unwrap_or(v),
+    };
+    locale_matcher(i, &options)?;
+    let kind = choice(i, &options, "type", "cardinal", &["cardinal", "ordinal"])?;
+    let notation = choice(
+        i,
+        &options,
+        "notation",
+        "standard",
+        &["standard", "compact", "scientific", "engineering"],
+    )?;
+    let compact = choice(i, &options, "compactDisplay", "short", &["short", "long"])?;
+    let int_value = i.member(&options, "minimumIntegerDigits")?;
+    let integer = number(i, &int_value, 1, 21, 1)?;
+    let min_f = i.member(&options, "minimumFractionDigits")?;
+    let max_f = i.member(&options, "maximumFractionDigits")?;
+    let min_s = i.member(&options, "minimumSignificantDigits")?;
+    let max_s = i.member(&options, "maximumSignificantDigits")?;
+    let inc_value = i.member(&options, "roundingIncrement")?;
+    let increment = number(i, &inc_value, 1, 5000, 1)?;
+    if ![
+        1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000, 2000, 2500, 5000,
+    ]
+    .contains(&increment)
+    {
+        return Err(range());
+    }
+    let mode = choice(
+        i,
+        &options,
+        "roundingMode",
+        "halfExpand",
+        &[
+            "ceil",
+            "floor",
+            "expand",
+            "trunc",
+            "halfCeil",
+            "halfFloor",
+            "halfExpand",
+            "halfTrunc",
+            "halfEven",
+        ],
+    )?;
+    let mut priority = choice(
+        i,
+        &options,
+        "roundingPriority",
+        "auto",
+        &["auto", "morePrecision", "lessPrecision"],
+    )?;
+    let trailing = choice(
+        i,
+        &options,
+        "trailingZeroDisplay",
+        "auto",
+        &["auto", "stripIfInteger"],
+    )?;
+    let has_sig = !matches!(min_s, Value::Undefined) || !matches!(max_s, Value::Undefined);
+    let compact_default = notation == "compact"
+        && !has_sig
+        && matches!(min_f, Value::Undefined)
+        && matches!(max_f, Value::Undefined)
+        && priority == "auto";
+    let (min_fraction, max_fraction) = if compact_default {
+        (0, 0)
+    } else {
+        let min = number(i, &min_f, 0, 100, 0)?;
+        let max = number(i, &max_f, 0, 100, 3.max(min))?;
+        let min = if matches!(min_f, Value::Undefined) {
+            0.min(max)
+        } else {
+            min
+        };
+        if min > max {
+            return Err(range());
+        }
+        (min, max)
+    };
+    let (min_significant, max_significant) = if has_sig || priority != "auto" || compact_default {
+        let min = number(i, &min_s, 1, 21, 1)?;
+        let max = number(i, &max_s, 1, 21, if compact_default { 2 } else { 21 })?;
+        if min > max {
+            return Err(range());
+        }
+        (Some(min), Some(max))
+    } else {
+        (None, None)
+    };
+    if compact_default {
+        priority = "morePrecision".into();
+    }
+    if increment != 1 {
+        if min_significant.is_some() || priority != "auto" {
+            return Err(VmErr::Msg(
+                "TypeError: Rounding increment requires fraction precision".into(),
+            ));
+        }
+        if min_fraction != max_fraction {
+            return Err(range());
+        }
+    }
+    let locale = requested
+        .iter()
+        .find_map(|v| best_available_locale(v))
+        .unwrap_or_else(|| "en-US".into());
+    let prefs: Locale = locale.parse().unwrap();
+    let options = if kind == "ordinal" {
+        PluralRuleType::Ordinal
+    } else {
+        PluralRuleType::Cardinal
+    }
+    .into();
+    let rules = Rc::new(PluralRules::try_new(prefs.clone().into(), options).map_err(|_| range())?);
+    let ranges =
+        Rc::new(PluralRulesWithRanges::try_new(prefs.into(), options).map_err(|_| range())?);
+    let object = Value::object_with_proto(vec![], prototype);
+    object
+        .property_cell()
+        .unwrap()
+        .meta
+        .borrow_mut()
+        .intl_plurals = Some(Slots {
+        rules,
+        ranges,
+        locale,
+        kind,
+        notation,
+        compact,
+        integer,
+        min_fraction,
+        max_fraction,
+        min_significant,
+        max_significant,
+        increment,
+        mode,
+        priority,
+        trailing,
+    });
+    Ok(object)
+}
+fn rounding(mode: &str) -> RM {
+    match mode {
+        "ceil" => RM::Ceil,
+        "floor" => RM::Floor,
+        "halfCeil" => RM::HalfCeil,
+        "halfFloor" => RM::HalfFloor,
+        "expand" => RM::Unsigned(UM::Expand),
+        "trunc" => RM::Unsigned(UM::Trunc),
+        "halfTrunc" => RM::Unsigned(UM::HalfTrunc),
+        "halfEven" => RM::Unsigned(UM::HalfEven),
+        _ => RM::Unsigned(UM::HalfExpand),
+    }
+}
+fn operands(s: &Slots, n: f64) -> Result<PluralOperands, VmErr> {
+    let mut decimal: Decimal = ryu_js::Buffer::new()
+        .format(n)
+        .parse()
+        .map_err(|_| range())?;
+    let exponent = if s.notation == "compact" && n.abs() >= 1000. {
+        (n.abs().log10().floor() as i16 / 3 * 3).min(12)
+    } else {
+        0
+    };
+    decimal.multiply_pow10(-exponent);
+    let mut fraction = decimal.clone();
+    let mut increment = s.increment;
+    let mut position = -s.max_fraction;
+    while increment % 10 == 0 {
+        increment /= 10;
+        position += 1;
+    }
+    let inc = match increment {
+        2 => RoundingIncrement::MultiplesOf2,
+        5 => RoundingIncrement::MultiplesOf5,
+        25 => RoundingIncrement::MultiplesOf25,
+        _ => RoundingIncrement::MultiplesOf1,
+    };
+    fraction.round_with_mode_and_increment(position, rounding(&s.mode), inc);
+    fraction.trim_end();
+    fraction.pad_end(-s.min_fraction);
+    if let (Some(min), Some(max)) = (s.min_significant, s.max_significant) {
+        let magnitude = decimal.absolute.nonzero_magnitude_start();
+        let precision = magnitude - max + 1;
+        decimal.round_with_mode(precision, rounding(&s.mode));
+        decimal.trim_end();
+        let padding = (decimal.absolute.nonzero_magnitude_start() - min + 1).min(0);
+        decimal.pad_end(padding);
+        if s.priority != "auto" {
+            let sig = precision;
+            let frac = -s.max_fraction;
+            if (s.priority == "morePrecision" && frac < sig)
+                || (s.priority == "lessPrecision" && frac >= sig)
+            {
+                decimal = fraction;
+            }
+        }
+    } else {
+        decimal = fraction;
+    }
+    if s.trailing == "stripIfInteger" {
+        decimal.trim_end_if_integer();
+    }
+    Ok(PluralOperands::from_significand_and_exponent(
+        &decimal.absolute,
+        exponent as u8,
+    ))
+}
+fn select(i: &mut Interpreter, this: Value, args: Vec<Value>) -> Result<Value, VmErr> {
+    let s = slot(&this)?;
+    let n = i.ecmascript_to_number(&arg(&args, 0))?;
+    let category = if n.is_finite() {
+        s.rules.category_for(operands(&s, n)?)
+    } else {
+        icu_plurals::PluralCategory::Other
+    };
+    Ok(Value::String(category_name(category).into()))
+}
+fn select_range(i: &mut Interpreter, this: Value, args: Vec<Value>) -> Result<Value, VmErr> {
+    let s = slot(&this)?;
+    if matches!(args.first(), None | Some(Value::Undefined))
+        || matches!(args.get(1), None | Some(Value::Undefined))
+    {
+        return Err(error());
+    }
+    let a = i.ecmascript_to_number(&args[0])?;
+    let b = i.ecmascript_to_number(&args[1])?;
+    if a.is_nan() || b.is_nan() {
+        return Err(range());
+    }
+    let category = if a.is_finite() && b.is_finite() {
+        let first = operands(&s, a)?;
+        let last = operands(&s, b)?;
+        s.ranges.category_for_range(first, last)
+    } else {
+        icu_plurals::PluralCategory::Other
+    };
+    Ok(Value::String(category_name(category).into()))
+}
+fn resolved_options(_: &mut Interpreter, this: Value, _: Vec<Value>) -> Result<Value, VmErr> {
+    let s = slot(&this)?;
+    let mut fields = vec![
+        ("locale".into(), Value::String(s.locale.into())),
+        ("type".into(), Value::String(s.kind.into())),
+        ("notation".into(), Value::String(s.notation.clone().into())),
+        (
+            "minimumIntegerDigits".into(),
+            Value::Number(s.integer as f64),
+        ),
+    ];
+    if s.min_significant.is_none() || s.priority != "auto" {
+        fields.extend([
+            (
+                "minimumFractionDigits".into(),
+                Value::Number(s.min_fraction as f64),
+            ),
+            (
+                "maximumFractionDigits".into(),
+                Value::Number(s.max_fraction as f64),
+            ),
+        ]);
+    }
+    if let (Some(min), Some(max)) = (s.min_significant, s.max_significant) {
+        fields.extend([
+            ("minimumSignificantDigits".into(), Value::Number(min as f64)),
+            ("maximumSignificantDigits".into(), Value::Number(max as f64)),
+        ]);
+    }
+    fields.extend([
+        (
+            "pluralCategories".into(),
+            Value::array(
+                s.rules
+                    .categories()
+                    .map(|c| Value::String(category_name(c).into()))
+                    .collect(),
+            ),
+        ),
+        (
+            "roundingIncrement".into(),
+            Value::Number(s.increment as f64),
+        ),
+        ("roundingMode".into(), Value::String(s.mode.into())),
+        ("roundingPriority".into(), Value::String(s.priority.into())),
+        (
+            "trailingZeroDisplay".into(),
+            Value::String(s.trailing.into()),
+        ),
+    ]);
+    if s.notation == "compact" {
+        fields.push(("compactDisplay".into(), Value::String(s.compact.into())));
+    }
+    Ok(Value::object(fields))
+}
+pub(super) fn install(e: &mut Environment, namespace: &Value) {
+    let fp = e.get("Function").and_then(|f| f.get_prop("prototype"));
+    let op = e.get("Object").and_then(|f| f.get_prop("prototype"));
+    let c = Value::object_with_proto(vec![], fp.clone().map(Rc::new));
+    super::super::make_callable(&c, super::super::require_new, Some(construct));
+    for (key, v) in [
+        ("name", Value::String("PluralRules".into())),
+        ("length", Value::Number(0.)),
+    ] {
+        nonenum(&c, key, v);
+        c.property_cell().unwrap().meta.borrow_mut().set_attrs(
+            key,
+            PropAttrs {
+                writable: false,
+                enumerable: false,
+                configurable: true,
+            },
+        );
+    }
+    nonenum(
+        &c,
+        "supportedLocalesOf",
+        native_method("supportedLocalesOf", 1, supported_locales, fp.clone()),
+    );
+    let p = Value::object_with_proto(vec![], op.map(Rc::new));
+    nonenum(&p, "constructor", c.clone());
+    tag(&p, "Intl.PluralRules");
+    for (name, len, f) in [
+        ("select", 1, select as NativeFn),
+        ("selectRange", 2, select_range),
+        ("resolvedOptions", 0, resolved_options),
+    ] {
+        nonenum(&p, name, native_method(name, len, f, fp.clone()));
+    }
+    super::super::set_builtin_constructor_prototype(e, &c, p.clone());
+    nonenum(namespace, "PluralRules", c.clone());
+    e.install_intrinsic("Intl.PluralRules", c);
+    e.install_intrinsic("Intl.PluralRules.prototype", p);
+}
+
+fn category_name(c: icu_plurals::PluralCategory) -> &'static str {
+    use icu_plurals::PluralCategory::*;
+    match c {
+        Zero => "zero",
+        One => "one",
+        Two => "two",
+        Few => "few",
+        Many => "many",
+        Other => "other",
+    }
+}
diff --git a/crates/napi-vm-core/src/interpreter/annex.rs b/crates/napi-vm-core/src/interpreter/annex.rs
new file mode 100644
index 0000000..3253aab
--- /dev/null
+++ b/crates/napi-vm-core/src/interpreter/annex.rs
@@ -0,0 +1,248 @@
+//! Annex B block-function eligibility and statement-time variable updates.
+use super::*;
+use crate::parser::{ForBinding, ForInit};
+use std::collections::HashSet;
+
+fn functions(body: &[Statement]) -> Vec<String> {
+    body.iter()
+        .filter_map(|s| match s {
+            Statement::FnDecl { name, .. } => Some(name.clone()),
+            _ => None,
+        })
+        .collect()
+}
+fn collect<'a>(
+    body: &'a [Statement],
+    outer: &HashSet<String>,
+    block: bool,
+    out: &mut Vec<(&'a Statement, String)>,
+) {
+    let mut blocked = outer.clone();
+    blocked.extend(crate::parser::top_lexical_names(body));
+    let mut nested = blocked.clone();
+    if block {
+        nested.extend(functions(body));
+    }
+    for statement in body {
+        match statement {
+            Statement::FnDecl {
+                name,
+                is_async: false,
+                is_generator: false,
+                annex_b_statement,
+                ..
+            } if (block || *annex_b_statement) && !blocked.contains(name) => {
+                out.push((statement, name.clone()))
+            }
+            Statement::Block(b)
+            | Statement::With { body: b, .. }
+            | Statement::While { body: b, .. }
+            | Statement::DoWhile { body: b, .. }
+            | Statement::ResourceForOf { body: b, .. } => collect(b, &nested, true, out),
+            Statement::Declarations(b)
+            | Statement::ResourceDeclaration {
+                declarations: b, ..
+            } => collect(b, &blocked, block, out),
+            Statement::If { then, else_, .. } => {
+                collect(then, &nested, true, out);
+                if let Some(b) = else_ {
+                    collect(b, &nested, true, out);
+                }
+            }
+            Statement::For { init, body, .. } => {
+                let mut names = nested.clone();
+                if let Some(init) = init {
+                    match init.as_ref() {
+                        ForInit::Var { kind, decls } if *kind != VarKind::Var => {
+                            names.extend(decls.iter().map(|(n, _)| n.clone()))
+                        }
+                        ForInit::Pattern {
+                            kind,
+                            pattern,
+                            trailing,
+                            ..
+                        } if *kind != VarKind::Var => {
+                            names.extend(pattern_names(pattern));
+                            names.extend(trailing.iter().map(|(n, _)| n.clone()));
+                        }
+                        _ => {}
+                    }
+                }
+                collect(body, &names, true, out);
+            }
+            Statement::ForIn { binding, body, .. } | Statement::ForOf { binding, body, .. } => {
+                let mut names = nested.clone();
+                if let ForBinding::Declaration { kind, pattern, .. } = binding {
+                    if *kind != VarKind::Var {
+                        names.extend(pattern_names(pattern));
+                    }
+                }
+                collect(body, &names, true, out);
+            }
+            Statement::Try {
+                body,
+                catch,
+                finally,
+            } => {
+                collect(body, &nested, true, out);
+                if let Some((parameter, b)) = catch {
+                    let mut names = nested.clone();
+                    if let Some(p) = parameter {
+                        if !matches!(p, crate::parser::Pattern::Ident(_)) {
+                            names.extend(pattern_names(p));
+                        }
+                    }
+                    collect(b, &names, true, out);
+                }
+                if let Some(b) = finally {
+                    collect(b, &nested, true, out);
+                }
+            }
+            Statement::Switch { cases, .. } => {
+                let mut names = nested.clone();
+                for case in cases {
+                    names.extend(crate::parser::top_lexical_names(&case.body));
+                }
+                for case in cases {
+                    collect(&case.body, &names, true, out);
+                }
+            }
+            Statement::Labeled { body, .. } => {
+                collect(std::slice::from_ref(body.as_ref()), &nested, block, out)
+            }
+            _ => {}
+        }
+    }
+}
+impl Interpreter {
+    pub(super) fn hoist_annex_functions(&mut self, body: &[Statement]) -> Result<(), VmErr> {
+        if self.global.borrow().strict() {
+            return Ok(());
+        }
+        let scope = self.global.clone();
+        let variable = Environment::variable_environment(&scope);
+        let mut blocked = HashSet::new();
+        if !scope.borrow().is_global_scope() && !scope.borrow().is_eval_scope() {
+            // Before var instantiation the function environment contains its
+            // parameter bindings and (when needed) the arguments object.
+            blocked.extend(scope.borrow().own_keys());
+        }
+        let mut candidates = Vec::new();
+        collect(body, &blocked, false, &mut candidates);
+        for (statement, name) in candidates {
+            // Eval must also respect intervening lexical environments.
+            let mut current = scope.clone();
+            let mut conflict = false;
+            loop {
+                if current.borrow().lexical_declaration(&name) {
+                    conflict = true;
+                    break;
+                }
+                if Rc::ptr_eq(&current, &variable) {
+                    break;
+                }
+                let next = current.borrow().parent_env();
+                let Some(next) = next else { break };
+                current = next;
+            }
+            if conflict {
+                continue;
+            }
+            // Non-declarable global names suppress the web extension.
+            if variable.borrow().is_global_scope() {
+                if let Some((_, attrs)) = variable.borrow().global_property(&name) {
+                    if !attrs.configurable && (!attrs.writable || !attrs.enumerable) {
+                        continue;
+                    }
+                } else if let Some(object) = variable.borrow().global_object() {
+                    if !self.is_extensible(&object)? {
+                        continue;
+                    }
+                }
+            }
+            self.hoist_var_binding_in(&scope, &name)?;
+            scope
+                .borrow_mut()
+                .annex_functions
+                .insert(statement as *const Statement as usize);
+        }
+        Ok(())
+    }
+    pub(super) fn evaluate_function_declaration(
+        &mut self,
+        statement: &Statement,
+    ) -> Result<Value, VmErr> {
+        let key = statement as *const Statement as usize;
+        let mut scope = self.global.clone();
+        loop {
+            if scope.borrow().annex_functions.contains(&key) {
+                let Statement::FnDecl { name, .. } = statement else {
+                    unreachable!()
+                };
+                let value = self.global.borrow().get(name).unwrap_or(Value::Undefined);
+                let target = Environment::variable_environment(&scope);
+                self.set_binding_in(&target, name, value)?;
+                break;
+            }
+            let next = scope.borrow().parent_env();
+            let Some(next) = next else { break };
+            scope = next;
+        }
+        Ok(Value::Undefined)
+    }
+}
+
+pub(crate) fn eligible<'a>(
+    body: &'a [Statement],
+    parameters: &[String],
+    arguments: bool,
+) -> Vec<(&'a Statement, String)> {
+    let mut blocked: HashSet<String> = parameters.iter().cloned().collect();
+    if arguments {
+        blocked.insert("arguments".into());
+    }
+    let mut result = Vec::new();
+    collect(body, &blocked, false, &mut result);
+    result
+}
+impl Interpreter {
+    pub(crate) fn init_compiled_annex(&mut self, scope: &Env, name: &str) -> Result<(), VmErr> {
+        if scope.borrow().strict() {
+            return Ok(());
+        }
+        let variable = Environment::variable_environment(scope);
+        if variable.borrow().lexical_declaration(name) {
+            return Ok(());
+        }
+        if variable.borrow().is_global_scope() {
+            if let Some((_, attrs)) = variable.borrow().global_property(name) {
+                if !attrs.configurable && (!attrs.writable || !attrs.enumerable) {
+                    return Ok(());
+                }
+            } else if let Some(object) = variable.borrow().global_object() {
+                if !self.is_extensible(&object)? {
+                    return Ok(());
+                }
+            }
+        }
+        self.hoist_var_binding_in(scope, name)?;
+        variable.borrow_mut().annex_names.insert(name.into());
+        Ok(())
+    }
+    pub(crate) fn update_compiled_annex(
+        &mut self,
+        scope: &Env,
+        name: &str,
+        value: Value,
+    ) -> Result<bool, VmErr> {
+        if scope.borrow().strict() {
+            return Ok(false);
+        }
+        let variable = Environment::variable_environment(scope);
+        if !variable.borrow().annex_names.contains(name) {
+            return Ok(false);
+        }
+        self.set_binding_in(&variable, name, value)?;
+        Ok(true)
+    }
+}
diff --git a/tests/function_declaration_semantics.rs b/tests/function_declaration_semantics.rs
new file mode 100644
index 0000000..dc8bd76
--- /dev/null
+++ b/tests/function_declaration_semantics.rs
@@ -0,0 +1,31 @@
+use napi_vm::{Interpreter, Value};
+fn check(source: &str, expected: &str) {
+    let mut vm = Interpreter::with_builtins();
+    vm.eval_source(source).unwrap();
+    let result = vm.eval_source("JSON.stringify(result)").unwrap();
+    assert!(
+        matches!(&result, Value::String(s) if s == expected),
+        "{result:?}"
+    );
+}
+#[test]
+fn declarations_preserve_hoisted_identity_and_prior_assignments() {
+    check(
+        r#"f.prototype=[1,2];var before=f;function f(){}var instance=new f();var result=[before===f,instance.length,instance.map(x=>x+1).join(',')];"#,
+        r#"[true,2,"2,3"]"#,
+    );
+}
+#[test]
+fn block_functions_update_the_variable_only_when_the_statement_executes() {
+    check(
+        r#"var result=(function(){var before=f;{var blockBefore=f;function f(){return 7}}return [before,blockBefore===f,f()];})();"#,
+        r#"[null,true,7]"#,
+    );
+}
+#[test]
+fn parameters_and_enclosing_lexicals_suppress_annex_b_bindings() {
+    check(
+        r#"var result=[(function(f){{function f(){}}return f})(3),(function(){{let f;{function f(){}}}return typeof f})(),(function(){'use strict';{function f(){}}return typeof f})()];"#,
+        r#"[3,"undefined","undefined"]"#,
+    );
+}
