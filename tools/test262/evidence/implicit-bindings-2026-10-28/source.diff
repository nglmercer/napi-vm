+#[test]
+fn function_implicit_bindings_remain_visible_to_dynamic_code_and_closures() {
+    let source = r#"
+        function plain() { return this.marker; }
+        function dynamic() { return eval('this.marker + (new.target ? 1 : 0)'); }
+        function captured() { return () => this.marker + (new.target ? 1 : 0); }
+        let receiver = { marker: 40 };
+        plain.call(receiver) === 40 && dynamic.call(receiver) === 40 &&
+          captured.call(receiver)() === 40 && new dynamic() !== null &&
+          new captured()() !== null;
+    "#;
+    check(source, true);
+    assert!(matches!(
+        run_ast_with_modules(source, &[]),
+        Ok(Value::Bool(true))
+    ));
+}
